# Copy to .env and fill in. Never commit real values.

# API
API_PORT=3000
ADMIN_CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=task_management

# Auth
# At least 32 characters
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# First Admin created by the seed script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Mail / SMTP configuration (Optional: leaves empty to use zero-config Ethereal test mailbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@gmail.com
SMTP_PASS=change-me
MAIL_FROM=sender-name
