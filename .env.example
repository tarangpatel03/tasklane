# Copy to .env and fill in. Never commit real values.

# API
API_PORT=3000
ADMIN_CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=task_management

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m

# Mail (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@taskapp.local

# First Admin created by the seed script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
